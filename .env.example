# Required: your Meta Model API key (https://dev.meta.ai)
MODEL_API_KEY=

# Optional settings
PORT=3000
HOST=0.0.0.0
MUSE_MODEL=muse-spark-1.3
# low | medium | high | xhigh | max  (lower = faster, cheaper replies)
MUSE_EFFORT=medium
# If set, the display asks for this passcode once before it can chat.
ACCESS_TOKEN=
# Optional: replaces the chat instructions (app-building rules are always added)
SYSTEM_PROMPT=
# Where apps Muse builds are saved when no Vercel Blob store is connected.
APPS_DIR=data/apps
# Set automatically on Vercel when you connect a Blob store:
# BLOB_READ_WRITE_TOKEN=
# BLOB_ACCESS=private
